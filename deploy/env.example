# ExpressAssistant 生产环境变量模板
# 复制到 /etc/expressassistant/env，chmod 600，属主 root:root。
# 这里只放占位符 —— 绝对不要把真实密钥 / Cookie / Token 提交进仓库。

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 数据目录（app.db、web/、backups/）
# DATA_DIR 由 systemd unit 设置；手动运行时可显式设置。
# DATA_DIR=/var/lib/expressassistant
# DB_PATH=/var/lib/expressassistant/app.db

# 主密钥路径由 systemd unit 的 Environment= 指定（LoadCredential 注入到
# /run/credentials/expressassistant.service/master.key）。不要在 env 文件里设置
# MASTER_KEY_FILE —— EnvironmentFile 的变量会覆盖 unit 里的 Environment=，
# 服务进程会去读 root 专属的 /etc/expressassistant/master.key 并报 EACCES。
# 只有手动运行 CLI 时才显式传入：
#   MASTER_KEY_FILE=/etc/expressassistant/master.key npm run create-user ...

PUBLIC_ORIGIN=https://express.example.com
SESSION_TTL_DAYS=30
# nginx 在 loopback 上，信任其 X-Forwarded-For
TRUST_PROXY=loopback

# 浏览器
CHROMIUM_PATH=/usr/bin/chromium
BROWSER_HEADLESS=0
DISPLAY=:99
BROWSER_MAX_CONTEXTS=2

# 调试用（生产不要打开）
# DISABLE_SCHEDULER=1
# DISABLE_BROWSER=1
